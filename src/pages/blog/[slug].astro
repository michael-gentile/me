---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import RelatedPosts from '../../components/RelatedPosts.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import { postMarkdownPath, postPagePath } from '../../lib/catalog'
import { formatPostDate } from '../../lib/dates'
import {
  formatReadingTime,
  readingDurationIso,
  readingMinutes,
} from '../../lib/reading-time'
import { absoluteUrl, homeUrl } from '../../lib/site'
import { blogFilterHref, relatedByTags } from '../../lib/tags'
import { withBase } from '../../lib/url'

export const getStaticPaths = async () => {
  const posts = (await getCollection('blog')).sort(
    (left, right) => right.data.date.valueOf() - left.data.date.valueOf()
  )
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedByTags(post, posts) },
  }))
}

type Props = {
  post: CollectionEntry<'blog'>
  related: CollectionEntry<'blog'>[]
}

const { post, related } = Astro.props
const { Content, headings } = await render(post)
const formattedDate = formatPostDate(post.data.date, {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
}).toUpperCase()
const minutes = readingMinutes(post.body ?? '')
const readingTime = formatReadingTime(minutes)
const pageUrl = absoluteUrl(postPagePath(post))
const markdownHref = absoluteUrl(postMarkdownPath(post))
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${pageUrl}#post`,
    headline: post.data.title,
    description: post.data.summary,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    inLanguage: 'en-CA',
    timeRequired: readingDurationIso(minutes),
    keywords: post.data.tags.join(', '),
    author: { '@id': `${homeUrl()}#person` },
    publisher: { '@id': `${homeUrl()}#person` },
  },
]
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  ogType="article"
  publishedTime={post.data.date}
  markdownHref={markdownHref}
  jsonLd={jsonLd}
>
  <article class="max-w-[65ch]">
    <p class="text-sm text-muted dark:text-muted-dark">
      <a
        class="hover:text-accent dark:hover:text-accent-dark"
        href={withBase('/blog')}
      >
        Blog
      </a>
    </p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight">{post.data.title}</h1>
    <p class="mt-5 font-serif text-xl leading-relaxed text-muted dark:text-muted-dark">
      {post.data.summary}
    </p>
    <p class="mt-6 text-sm uppercase tracking-[0.14em] text-muted dark:text-muted-dark">
      <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true"> · </span>
      <span>{readingTime}</span>
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
          {post.data.tags.map((tag) => (
            <li>
              <a
                class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent dark:border-line-dark dark:text-muted-dark dark:hover:border-accent-dark dark:hover:text-accent-dark"
                href={blogFilterHref(tag)}
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <TableOfContents headings={headings} />
    <div class="prose mt-8 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
  <RelatedPosts posts={related} />
</BaseLayout>
