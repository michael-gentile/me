---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import PostFilter from '../../components/PostFilter.astro'
import { uniquePostTags } from '../../lib/tags'

const PAGE_SIZE = 10

const posts = (await getCollection('blog')).sort(
  (left, right) => right.data.date.valueOf() - left.data.date.valueOf()
)
const tags = uniquePostTags(posts)
const hasMore = posts.length > PAGE_SIZE
---

<BaseLayout
  title="Blog"
  description="Technical notes from Michael Gentile on language models, how things work under the hood, and anything else he is tinkering with."
>
  <section class="max-w-[65ch]">
    <p class="text-sm uppercase tracking-[0.18em] text-accent dark:text-accent-dark">Blog</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Notes from the lab</h1>
    <p class="mt-4 text-lg text-muted dark:text-muted-dark">
      Read what I've been learning about.
    </p>
    {posts.length > 0 && <PostFilter pageSize={PAGE_SIZE} tags={tags} />}
  </section>

  <section class="mt-12 max-w-[65ch]" aria-labelledby="all-posts">
    {
      posts.length === 0 ? (
        <p class="text-muted dark:text-muted-dark">Nothing published yet.</p>
      ) : (
        <>
          <h2
            id="all-posts"
            class="border-b border-line pb-3 text-sm uppercase tracking-[0.18em] text-muted dark:border-line-dark dark:text-muted-dark"
          >
            Posts
          </h2>
          <div class="mt-6 flex flex-col gap-10" data-post-list>
            {posts.map((post, index) => (
              <PostCard
                deferPaint={index >= 2}
                initiallyHidden={index >= PAGE_SIZE}
                post={post}
              />
            ))}
            <p
              class="py-4 text-muted dark:text-muted-dark"
              data-filter-empty
              hidden
            >
              No posts match that search.
            </p>
          </div>
          {
            hasMore && (
              <p class="mt-10">
                <button
                  type="button"
                  class="text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-hover-dark"
                  data-load-more
                  aria-controls="all-posts"
                >
                  Show more posts
                </button>
              </p>
            )
          }
        </>
      )
    }
  </section>

  <noscript>
    <style>
      [data-post-card][hidden] {
        display: block !important;
      }
      [data-load-more] {
        display: none !important;
      }
    </style>
  </noscript>
</BaseLayout>
