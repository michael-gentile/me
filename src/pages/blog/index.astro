---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import PostFilter from '../../components/PostFilter.astro'
import { postMatchesFilter, uniquePostTags } from '../../lib/tags'

const PAGE_SIZE = 10

const posts = (await getCollection('blog')).sort(
  (left, right) => right.data.date.valueOf() - left.data.date.valueOf()
)
const tags = uniquePostTags(posts)

const initialQuery = (Astro.url.searchParams.get('q') ?? '').trim()
const initialQueryLower = initialQuery.toLowerCase()
const requestedTag = (Astro.url.searchParams.get('tag') ?? '').trim()
const requestedTagLower = requestedTag.toLowerCase()
const knownTags = new Set(tags.map((tag) => tag.toLowerCase()))
const initialTag =
  requestedTagLower && knownTags.has(requestedTagLower) ? requestedTag : ''
const activeTagLower = initialTag.toLowerCase()
const hasActiveFilter = initialQueryLower !== '' || activeTagLower !== ''

const matchFlags = posts.map((post) =>
  postMatchesFilter(
    post.data.title.toLowerCase(),
    post.data.tags.map((tag) => tag.toLowerCase()),
    initialQueryLower,
    activeTagLower
  )
)
const matchCount = matchFlags.filter(Boolean).length

// With an active filter, show all matches without JS. Otherwise page the list.
let matchOrdinal = 0
const cardState = matchFlags.map((matches) => {
  if (!matches) {
    return { matches: false, initiallyHidden: true, ssrExcluded: true }
  }

  const ordinal = matchOrdinal
  matchOrdinal += 1
  const pastPage = !hasActiveFilter && ordinal >= PAGE_SIZE
  return {
    matches: true,
    initiallyHidden: pastPage,
    ssrExcluded: false,
  }
})

const shownCount = cardState.filter((state) => state.matches && !state.initiallyHidden).length
const hasMore = hasActiveFilter ? false : matchCount > PAGE_SIZE
---

<BaseLayout
  title="Blog"
  description="Technical notes from Michael Gentile on language models, how things work under the hood, and anything else he is tinkering with."
>
  <section>
    <p class="text-sm uppercase tracking-[0.18em] text-accent dark:text-accent-dark">Blog</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Notes from the lab</h1>
    <p class="mt-4 text-lg text-muted dark:text-muted-dark">
      Read what I've been learning about.
    </p>
    {
      posts.length > 0 && (
        <PostFilter
          pageSize={PAGE_SIZE}
          tags={tags}
          initialQuery={initialQuery}
          initialTag={initialTag}
          totalCount={posts.length}
          matchCount={matchCount}
          shownCount={shownCount}
        />
      )
    }
  </section>

  <section class="mt-12" aria-labelledby="all-posts">
    {
      posts.length === 0 ? (
        <p class="text-muted dark:text-muted-dark">Nothing published yet.</p>
      ) : (
        <>
          <h2
            id="all-posts"
            class="border-b border-line pb-3 text-sm uppercase tracking-[0.18em] text-muted dark:border-line-dark dark:text-muted-dark"
          >
            Posts
          </h2>
          <div class="mt-6 flex flex-col gap-10" id="post-list" data-post-list>
            {posts.map((post, index) => (
              <PostCard
                deferPaint={index >= 2}
                headingLevel="h3"
                initiallyHidden={cardState[index].initiallyHidden}
                post={post}
                ssrExcluded={cardState[index].ssrExcluded}
              />
            ))}
            <p
              class="py-4 text-muted dark:text-muted-dark"
              data-filter-empty
              hidden={matchCount > 0 || undefined}
            >
              No posts match that search.
            </p>
          </div>
          {
            hasMore && (
              <p class="mt-10">
                <button
                  type="button"
                  class="text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-hover-dark"
                  data-load-more
                  aria-controls="post-list"
                >
                  Show more posts
                </button>
              </p>
            )
          }
        </>
      )
    }
  </section>

  <noscript>
    <style>
      /* Reveal pagination-hidden cards only; keep SSR filter exclusions hidden. */
      [data-post-card][hidden]:not([data-ssr-excluded]) {
        display: block !important;
      }
      [data-load-more] {
        display: none !important;
      }
    </style>
  </noscript>
</BaseLayout>
