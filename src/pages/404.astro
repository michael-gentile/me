---
import Ascii from 'ascii.rest/astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/url'
---

<BaseLayout
  title="Not found"
  description="That page is not on this site."
  noIndex={true}
>
  <section class="max-w-full">
    <div class="overflow-x-auto text-ink dark:text-ink-dark">
      <Ascii
        class="mx-auto w-fit text-[11px] leading-[1.15] sm:text-xs md:text-sm"
        piece="not-found"
        label="Animated ASCII art: a block-letter 404 with a small ghost drifting beneath it"
        options={{
          code: '404',
          title: 'page not found',
          message: 'that url is not part of this site',
        }}
      />
    </div>
    <p class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-base">
      <a
        class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:text-accent-hover hover:decoration-accent dark:text-accent-dark dark:decoration-accent-dark/40 dark:hover:text-accent-hover-dark dark:hover:decoration-accent-dark"
        href={withBase('/')}
      >
        Take me back Home
      </a>
      <a
        class="text-muted hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark"
        href={withBase('/blog')}
      >
        Check out the Blog
      </a>
    </p>
  </section>
</BaseLayout>
