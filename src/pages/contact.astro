---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteMeta } from '../config'
---

<BaseLayout
  title="Contact"
  description={`How to reach ${siteMeta.name}.`}
>
  <section>
    <p class="text-sm uppercase tracking-[0.18em] text-accent dark:text-accent-dark">
      Contact
    </p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight">Get in touch</h1>
    <p class="mt-4 text-lg text-muted dark:text-muted-dark">
      <a
        class="text-accent underline underline-offset-[3px] hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-hover-dark"
        href={siteMeta.linkedinUrl}
        rel="noreferrer"
        target="_blank"
        aria-label="Open LinkedIn profile"
      >
        LinkedIn
      </a>
      {' '}is the easiest way to say hello. Check out the code for this site on{' '}
      <a
        class="text-accent underline underline-offset-[3px] hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-hover-dark"
        href={siteMeta.githubRepoUrl}
        rel="noreferrer"
        target="_blank"
        aria-label="Open this site's GitHub repository"
      >
        GitHub
      </a>.
    </p>
  </section>
</BaseLayout>
