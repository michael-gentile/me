---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { siteMeta } from '../config'
import { withBase } from '../lib/url'

const posts = (await getCollection('blog')).sort(
  (left, right) => right.data.date.valueOf() - left.data.date.valueOf()
)
const latestPosts = posts.slice(0, 1)
---

<BaseLayout>
  <section>
    <p class="text-sm uppercase tracking-[0.18em] text-accent dark:text-accent-dark">
      {siteMeta.location}
    </p>
    <h1 class="mt-4 font-serif text-5xl leading-tight tracking-tight sm:text-6xl">
      {siteMeta.name}
    </h1>
    <p class="mt-6 text-xl text-ink dark:text-ink-dark">
      {siteMeta.role}
    </p>
    <p class="mt-4 text-lg text-muted dark:text-muted-dark">
      {siteMeta.tagline}
    </p>
    <p class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-base">
      <a
        class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:text-accent-hover hover:decoration-accent dark:text-accent-dark dark:decoration-accent-dark/40 dark:hover:text-accent-hover-dark dark:hover:decoration-accent-dark"
        href={withBase('/blog')}
      >
        Browse all {posts.length} posts
      </a>
      <a
        class="text-muted hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark"
        href={withBase('/contact')}
      >
        Get in contact
      </a>
    </p>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="mt-16" aria-labelledby="latest-posts">
        <h2
          id="latest-posts"
          class="border-b border-line pb-3 text-sm uppercase tracking-[0.18em] text-muted dark:border-line-dark dark:text-muted-dark"
        >
          Latest Post
        </h2>
        <div class="mt-6 flex flex-col gap-10">
          {latestPosts.map((post) => (
            <PostCard headingLevel="h3" post={post} />
          ))}
        </div>
        <p class="mt-8">
          <a
            class="text-sm text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-hover-dark"
            href={withBase('/blog')}
          >
            All posts
          </a>
        </p>
      </section>
    )
  }
</BaseLayout>
