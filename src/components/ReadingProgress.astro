---
---

<div
  class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1 bg-transparent print:hidden"
  data-reading-progress
  hidden
  aria-hidden="true"
>
  <div
    class="h-full w-0 bg-accent dark:bg-accent-dark"
    data-reading-progress-bar
  ></div>
</div>

<script>
  const setupReadingProgress = () => {
    const root = document.querySelector<HTMLElement>('[data-reading-progress]')
    const bar = document.querySelector<HTMLElement>('[data-reading-progress-bar]')
    const article = document.querySelector('article')

    if (!root || !bar || !article) {
      return
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.hidden = true
      return
    }

    // Soft-nav remounts this node; skip only if this instance is already bound.
    if (root.dataset.bound === 'true') {
      return
    }

    root.dataset.bound = 'true'
    root.hidden = false

    const update = () => {
      const rect = article.getBoundingClientRect()
      const articleTop = window.scrollY + rect.top
      const articleHeight = article.offsetHeight
      const viewport = window.innerHeight
      const start = articleTop
      const end = articleTop + articleHeight - viewport
      const range = Math.max(end - start, 1)
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / range))
      bar.style.width = `${progress * 100}%`
    }

    update()
    window.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)

    document.addEventListener(
      'astro:before-preparation',
      () => {
        window.removeEventListener('scroll', update)
        window.removeEventListener('resize', update)
      },
      { once: true }
    )
  }

  setupReadingProgress()
  document.addEventListener('astro:page-load', setupReadingProgress)
</script>

<style>
  @media print {
    [data-reading-progress] {
      display: none !important;
    }
  }
</style>
