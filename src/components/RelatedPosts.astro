---
import type { CollectionEntry } from 'astro:content'
import PostCard from './PostCard.astro'
import { withBase } from '../lib/url'

type Props = {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 ? (
    <section class="mt-16" aria-labelledby="related-posts">
      <h2
        id="related-posts"
        class="border-b border-line pb-3 text-sm uppercase tracking-[0.18em] text-accent dark:border-line-dark dark:text-accent-dark"
      >
        Related posts
      </h2>
      <div class="mt-6 flex flex-col gap-6">
        {posts.map((post) => (
          <PostCard headingLevel="h3" post={post} />
        ))}
      </div>
      <p class="mt-8">
        <a
          class="text-sm text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-hover-dark"
          href={withBase('/blog')}
        >
          All posts
        </a>
      </p>
    </section>
  ) : (
    <p class="mt-16">
      <a
        class="text-sm text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-hover-dark"
        href={withBase('/blog')}
      >
        All posts
      </a>
    </p>
  )
}
