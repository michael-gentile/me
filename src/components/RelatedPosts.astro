---
import type { CollectionEntry } from 'astro:content'
import { withBase } from '../lib/url'

type Props = {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <section class="mt-16 max-w-[65ch]" aria-labelledby="related-posts">
      <h2
        id="related-posts"
        class="border-b border-line pb-3 text-sm uppercase tracking-[0.18em] text-accent dark:border-line-dark dark:text-accent-dark"
      >
        Related posts
      </h2>
      <div class="mt-6 flex flex-col gap-10">
        {posts.map((post) => (
          <article>
            <h3 class="font-serif text-2xl tracking-tight">
              <a
                class="text-ink hover:text-accent dark:text-ink-dark dark:hover:text-accent-dark"
                href={withBase(`/blog/${post.id}`)}
              >
                {post.data.title}
              </a>
            </h3>
            <p class="mt-2 text-base leading-relaxed text-muted dark:text-muted-dark">
              {post.data.summary}
            </p>
          </article>
        ))}
      </div>
    </section>
  )
}
