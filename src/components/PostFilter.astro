---
/**
 * Blog list filter: title/tag search plus tag chips, and paging via Show more.
 * Matching rules match SSR in blog/index (postMatchesFilter). With JS, filters
 * read/write ?q=/?tag= on the client. On static GitHub Pages the prerendered
 * index has no query string, so without JS tag links reload the same full list;
 * Astro.url filter state applies in `astro dev` (and would on SSR hosts).
 */
import { blogFilterHref } from '../lib/tags'

type Props = {
  tags: string[]
  pageSize?: number
  initialQuery?: string
  initialTag?: string
  /** Total posts on the page (for visible count copy). */
  totalCount?: number
  /** Matching posts after SSR filter (before paging). */
  matchCount?: number
  /** Visible posts after SSR paging. */
  shownCount?: number
}

const {
  tags,
  pageSize = 10,
  initialQuery = '',
  initialTag = '',
  totalCount = 0,
  matchCount = 0,
  shownCount = 0,
} = Astro.props

const activeTagLower = initialTag.toLowerCase()
const knownTagSet = new Set(tags.map((tag) => tag.toLowerCase()))
const hasKnownActiveTag = activeTagLower !== '' && knownTagSet.has(activeTagLower)
const isAllCurrent = !hasKnownActiveTag

const statusText = (() => {
  if (matchCount === totalCount && shownCount === matchCount) {
    return ''
  }

  if (shownCount < matchCount) {
    return `${shownCount} of ${matchCount} posts shown`
  }

  return `${matchCount} post${matchCount === 1 ? '' : 's'} shown`
})()

const chipClass =
  'inline-block rounded-full border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent aria-current:border-accent aria-current:font-medium aria-current:text-accent aria-current:underline aria-current:underline-offset-2 dark:border-line-dark dark:text-muted-dark dark:hover:border-accent-dark dark:hover:text-accent-dark dark:aria-current:border-accent-dark dark:aria-current:text-accent-dark'
---

{
  tags.length > 0 && (
    <div class="mt-8" data-post-filter data-page-size={pageSize}>
      <label class="sr-only" for="post-search">
        Search posts by title or tag
      </label>
      <input
        id="post-search"
        name="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search titles and tags"
        value={initialQuery}
        class="w-full border-b border-line bg-transparent py-2 text-base text-ink placeholder:text-muted focus:border-accent dark:border-line-dark dark:text-ink-dark dark:placeholder:text-muted-dark dark:focus:border-accent-dark"
        data-post-search
      />
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Filter by tag">
        <li>
          <a
            href={blogFilterHref()}
            class={chipClass}
            data-tag-filter
            data-tag=""
            aria-current={isAllCurrent ? 'true' : undefined}
          >
            All
          </a>
        </li>
        {
          tags.map((tag) => {
            const isActive = hasKnownActiveTag && tag.toLowerCase() === activeTagLower
            return (
              <li>
                <a
                  href={blogFilterHref(tag)}
                  class={chipClass}
                  data-tag-filter
                  data-tag={tag}
                  aria-current={isActive ? 'true' : undefined}
                >
                  {tag}
                </a>
              </li>
            )
          })
        }
      </ul>
      <p
        class="mt-3 min-h-[1.25rem] text-sm text-muted dark:text-muted-dark"
        aria-live="polite"
        data-filter-status
      >
        {statusText}
      </p>
    </div>
  )
}

<script>
  import { postMatchesFilter } from '../lib/tags'

  const setupPostFilter = () => {
    const root = document.querySelector<HTMLElement>('[data-post-filter]')
    if (!root || root.dataset.bound === 'true') {
      return
    }

    const searchInput = root.querySelector<HTMLInputElement>('[data-post-search]')
    const status = document.querySelector('[data-filter-status]')
    const empty = document.querySelector('[data-filter-empty]')
    const loadMore = document.querySelector<HTMLButtonElement>('[data-load-more]')
    const cards = [...document.querySelectorAll<HTMLElement>('[data-post-card]')]
    const tagLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-tag-filter]')]
    const pageSize = Number(root.getAttribute('data-page-size') ?? 10) || 10

    if (cards.length === 0) {
      return
    }

    root.dataset.bound = 'true'
    let revealed = pageSize

    const readFilters = () => {
      const params = new URLSearchParams(window.location.search)
      return {
        query: (params.get('q') ?? '').trim().toLowerCase(),
        tag: (params.get('tag') ?? '').trim().toLowerCase(),
      }
    }

    const writeFilters = (query: string, tag: string) => {
      const params = new URLSearchParams()

      if (query) {
        params.set('q', query)
      }

      if (tag) {
        params.set('tag', tag)
      }

      const search = params.toString()
      const next = `${window.location.pathname}${search ? `?${search}` : ''}${window.location.hash}`
      window.history.replaceState({}, '', next)
    }

    const selectedTag = () =>
      tagLinks.find((link) => link.getAttribute('aria-current') === 'true')?.dataset.tag ?? ''

    const cardMatches = (card: HTMLElement, query: string, activeTagLower: string) => {
      const title = card.dataset.title ?? ''
      const tags = (card.dataset.tags ?? '')
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean)
      return postMatchesFilter(title, tags, query, activeTagLower)
    }

    const applyFilters = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? ''
      const activeTagLower = selectedTag().toLowerCase()
      let matchCount = 0
      let shownCount = 0

      for (const card of cards) {
        const matches = cardMatches(card, query, activeTagLower)
        card.removeAttribute('data-ssr-excluded')

        if (!matches) {
          card.hidden = true
          continue
        }

        matchCount += 1

        if (shownCount < revealed) {
          card.hidden = false
          shownCount += 1
        } else {
          card.hidden = true
        }
      }

      if (empty instanceof HTMLElement) {
        empty.hidden = matchCount > 0
      }

      if (loadMore) {
        const hasMore = matchCount > revealed
        loadMore.hidden = !hasMore
        if (loadMore.parentElement instanceof HTMLElement) {
          loadMore.parentElement.hidden = !hasMore
        }
      }

      if (status) {
        if (matchCount === cards.length && shownCount === matchCount) {
          status.textContent = ''
        } else if (shownCount < matchCount) {
          status.textContent = `${shownCount} of ${matchCount} posts shown`
        } else {
          status.textContent = `${matchCount} post${matchCount === 1 ? '' : 's'} shown`
        }
      }
    }

    const setActiveTag = (tag: string) => {
      for (const link of tagLinks) {
        const isActive = (link.dataset.tag ?? '').toLowerCase() === tag.toLowerCase()
        if (isActive) {
          link.setAttribute('aria-current', 'true')
        } else {
          link.removeAttribute('aria-current')
        }
      }
    }

    const resetAndApply = () => {
      revealed = pageSize
      applyFilters()
    }

    const { query, tag } = readFilters()

    if (searchInput && (query || tag)) {
      searchInput.value = query
      setActiveTag(tag)
    }

    // Always page the list once JS is available (SSR hid cards past pageSize).
    applyFilters()

    searchInput?.addEventListener('input', () => {
      writeFilters(searchInput.value.trim(), selectedTag())
      resetAndApply()
    })

    for (const link of tagLinks) {
      link.addEventListener('click', (event) => {
        event.preventDefault()
        const nextTag = link.dataset.tag ?? ''
        setActiveTag(nextTag)
        writeFilters(searchInput?.value.trim() ?? '', nextTag)
        resetAndApply()
      })
    }

    loadMore?.addEventListener('click', () => {
      revealed += pageSize
      applyFilters()
    })
  }

  setupPostFilter()
  document.addEventListener('astro:page-load', setupPostFilter)
</script>
