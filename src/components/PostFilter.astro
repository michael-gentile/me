---
/**
 * Client-side filter for the blog list: title/tag search plus tag chips.
 * Also pages the list (see pageSize) via the Show more button on the blog page.
 * Tag links still work without JS via ?tag= on the URL.
 */
import { blogFilterHref } from '../lib/tags'

type Props = {
  tags: string[]
  pageSize?: number
}

const { tags, pageSize = 10 } = Astro.props
---

{
  tags.length > 0 && (
    <div class="mt-8" data-post-filter data-page-size={pageSize}>
      <label class="sr-only" for="post-search">
        Search posts by title or tag
      </label>
      <input
        id="post-search"
        name="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search titles and tags"
        class="w-full border-b border-line bg-transparent py-2 text-base text-ink placeholder:text-muted focus:border-accent dark:border-line-dark dark:text-ink-dark dark:placeholder:text-muted-dark dark:focus:border-accent-dark"
        data-post-search
      />
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Filter by tag">
        <li>
          <a
            href={blogFilterHref()}
            class="inline-block rounded-full border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent aria-current:border-accent aria-current:text-accent dark:border-line-dark dark:text-muted-dark dark:hover:border-accent-dark dark:hover:text-accent-dark dark:aria-current:border-accent-dark dark:aria-current:text-accent-dark"
            data-tag-filter
            data-tag=""
            aria-current="true"
          >
            All
          </a>
        </li>
        {
          tags.map((tag) => (
            <li>
              <a
                href={blogFilterHref(tag)}
                class="inline-block rounded-full border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent aria-current:border-accent aria-current:text-accent dark:border-line-dark dark:text-muted-dark dark:hover:border-accent-dark dark:hover:text-accent-dark dark:aria-current:border-accent-dark dark:aria-current:text-accent-dark"
                data-tag-filter
                data-tag={tag}
              >
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="sr-only" aria-live="polite" data-filter-status></p>
    </div>
  )
}

<script>
  const setupPostFilter = () => {
    const root = document.querySelector<HTMLElement>('[data-post-filter]')
    if (!root || root.dataset.bound === 'true') {
      return
    }

    const searchInput = root.querySelector<HTMLInputElement>('[data-post-search]')
    const status = document.querySelector('[data-filter-status]')
    const empty = document.querySelector('[data-filter-empty]')
    const loadMore = document.querySelector<HTMLButtonElement>('[data-load-more]')
    const cards = [...document.querySelectorAll<HTMLElement>('[data-post-card]')]
    const tagLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-tag-filter]')]
    const pageSize = Number(root.getAttribute('data-page-size') ?? 10) || 10

    if (cards.length === 0) {
      return
    }

    root.dataset.bound = 'true'
    let revealed = pageSize

    const readFilters = () => {
      const params = new URLSearchParams(window.location.search)
      return {
        query: (params.get('q') ?? '').trim().toLowerCase(),
        tag: (params.get('tag') ?? '').trim().toLowerCase(),
      }
    }

    const writeFilters = (query: string, tag: string) => {
      const params = new URLSearchParams()

      if (query) {
        params.set('q', query)
      }

      if (tag) {
        params.set('tag', tag)
      }

      const search = params.toString()
      const next = `${window.location.pathname}${search ? `?${search}` : ''}${window.location.hash}`
      window.history.replaceState({}, '', next)
    }

    const selectedTag = () =>
      tagLinks.find((link) => link.getAttribute('aria-current') === 'true')?.dataset.tag ?? ''

    const cardMatches = (card: HTMLElement, query: string, activeTagLower: string) => {
      const title = card.dataset.title ?? ''
      const tags = (card.dataset.tags ?? '')
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean)
      const matchesQuery = !query || title.includes(query) || tags.some((tag) => tag.includes(query))
      const matchesTag = !activeTagLower || tags.includes(activeTagLower)
      return matchesQuery && matchesTag
    }

    const applyFilters = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? ''
      const activeTagLower = selectedTag().toLowerCase()
      let matchCount = 0
      let shownCount = 0

      for (const card of cards) {
        const matches = cardMatches(card, query, activeTagLower)

        if (!matches) {
          card.hidden = true
          continue
        }

        matchCount += 1

        if (shownCount < revealed) {
          card.hidden = false
          shownCount += 1
        } else {
          card.hidden = true
        }
      }

      if (empty instanceof HTMLElement) {
        empty.hidden = matchCount > 0
      }

      if (loadMore) {
        const hasMore = matchCount > revealed
        loadMore.hidden = !hasMore
        if (loadMore.parentElement instanceof HTMLElement) {
          loadMore.parentElement.hidden = !hasMore
        }
      }

      if (status) {
        if (matchCount === cards.length && shownCount === matchCount) {
          status.textContent = ''
        } else if (shownCount < matchCount) {
          status.textContent = `${shownCount} of ${matchCount} posts shown`
        } else {
          status.textContent = `${matchCount} post${matchCount === 1 ? '' : 's'} shown`
        }
      }
    }

    const setActiveTag = (tag: string) => {
      for (const link of tagLinks) {
        const isActive = (link.dataset.tag ?? '').toLowerCase() === tag.toLowerCase()
        if (isActive) {
          link.setAttribute('aria-current', 'true')
        } else {
          link.removeAttribute('aria-current')
        }
      }
    }

    const resetAndApply = () => {
      revealed = pageSize
      applyFilters()
    }

    const { query, tag } = readFilters()

    if (searchInput && (query || tag)) {
      searchInput.value = query
      setActiveTag(tag)
    }

    // Always page the list once JS is available (SSR hid cards past pageSize).
    applyFilters()

    searchInput?.addEventListener('input', () => {
      writeFilters(searchInput.value.trim(), selectedTag())
      resetAndApply()
    })

    for (const link of tagLinks) {
      link.addEventListener('click', (event) => {
        event.preventDefault()
        const nextTag = link.dataset.tag ?? ''
        setActiveTag(nextTag)
        writeFilters(searchInput?.value.trim() ?? '', nextTag)
        resetAndApply()
      })
    }

    loadMore?.addEventListener('click', () => {
      revealed += pageSize
      applyFilters()
    })
  }

  setupPostFilter()
  document.addEventListener('astro:page-load', setupPostFilter)
</script>
