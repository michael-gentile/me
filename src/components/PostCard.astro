---
import type { CollectionEntry } from 'astro:content'
import { formatPostDate } from '../lib/dates'
import { formatReadingTime, readingMinutes } from '../lib/reading-time'
import { blogFilterHref } from '../lib/tags'
import { withBase } from '../lib/url'

type Props = {
  post: CollectionEntry<'blog'>
  headingLevel?: 'h2' | 'h3'
  deferPaint?: boolean
  initiallyHidden?: boolean
}

const {
  post,
  headingLevel: Heading = 'h2',
  deferPaint = false,
  initiallyHidden = false,
} = Astro.props
const formattedDate = formatPostDate(post.data.date)
const readingTime = formatReadingTime(readingMinutes(post.body ?? ''))
const tagList = post.data.tags.map((tag) => tag.toLowerCase()).join(',')
---

<article
  class="py-1"
  data-post-card
  data-title={post.data.title.toLowerCase()}
  data-tags={tagList}
  data-defer-paint={deferPaint || undefined}
  hidden={initiallyHidden || undefined}
>
  <p class="text-sm text-muted dark:text-muted-dark">
    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true"> · </span>
    <span>{readingTime}</span>
  </p>
  <Heading class="mt-2 font-serif text-2xl tracking-tight">
    <a
      class="text-ink hover:text-accent dark:text-ink-dark dark:hover:text-accent-dark"
      href={withBase(`/blog/${post.id}`)}
    >
      {post.data.title}
    </a>
  </Heading>
  <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-muted dark:text-muted-dark">
    {post.data.summary}
  </p>
  {
    post.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <li>
            <a
              class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent dark:border-line-dark dark:text-muted-dark dark:hover:border-accent-dark dark:hover:text-accent-dark"
              href={blogFilterHref(tag)}
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
