---
import type { CollectionEntry } from 'astro:content'
import { formatPostDate } from '../lib/dates'
import { formatReadingTime, readingMinutes } from '../lib/reading-time'
import { blogFilterHref } from '../lib/tags'
import { withBase } from '../lib/url'

type Props = {
  post: CollectionEntry<'blog'>
  headingLevel?: 'h2' | 'h3'
  deferPaint?: boolean
  initiallyHidden?: boolean
  /** Filter non-match at SSR; noscript must not force these visible. */
  ssrExcluded?: boolean
}

const {
  post,
  headingLevel: Heading = 'h2',
  deferPaint = false,
  initiallyHidden = false,
  ssrExcluded = false,
} = Astro.props
const formattedDate = formatPostDate(post.data.date)
const readingTime = formatReadingTime(readingMinutes(post.body ?? ''))
const tagList = post.data.tags.map((tag) => tag.toLowerCase()).join(',')
const postHref = withBase(`/blog/${post.id}`)
---

<article
  class="group relative rounded-md border border-line/80 bg-transparent px-4 py-4 transition-colors hover:border-accent/45 hover:bg-accent/5 focus-within:border-accent/45 focus-within:bg-accent/5 dark:border-line-dark/80 dark:hover:border-accent-dark/45 dark:hover:bg-accent-dark/5 dark:focus-within:border-accent-dark/45 dark:focus-within:bg-accent-dark/5"
  data-post-card
  data-title={post.data.title.toLowerCase()}
  data-tags={tagList}
  data-defer-paint={deferPaint || undefined}
  data-ssr-excluded={ssrExcluded || undefined}
  hidden={initiallyHidden || undefined}
>
  <Heading class="font-serif text-2xl tracking-tight">
    <a
      class="text-ink after:absolute after:inset-0 after:z-[1] group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark"
      href={postHref}
    >
      {post.data.title}
    </a>
  </Heading>
  <p class="mt-3 text-base leading-relaxed text-muted dark:text-muted-dark">
    {post.data.summary}
  </p>
  <p class="mt-3 text-sm text-muted dark:text-muted-dark">
    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true"> · </span>
    <span>{readingTime}</span>
  </p>
  {
    post.data.tags.length > 0 && (
      <ul class="relative z-10 mt-4 flex flex-wrap gap-2" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <li>
            <a
              class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent dark:border-line-dark dark:text-muted-dark dark:hover:border-accent-dark dark:hover:text-accent-dark"
              href={blogFilterHref(tag)}
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
