---
import { navItems, siteMeta } from '../config'
import { isCurrentPath, withBase } from '../lib/url'
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-paper"
>
  Skip to content
</a>

<header class="border-b border-line dark:border-line-dark">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a
      href={withBase('/')}
      class="font-serif text-lg tracking-tight text-ink no-underline hover:text-accent dark:text-ink-dark dark:hover:text-accent-dark"
      data-nav-home
      aria-current={isCurrentPath(pathname, '/') ? 'page' : undefined}
      aria-label={`${siteMeta.name} home`}
      transition:name="site-name"
    >
      {siteMeta.name}
    </a>
    <div class="flex items-center gap-3 sm:gap-5">
      <nav aria-label="Primary">
        <ul class="flex items-center gap-4 text-sm sm:gap-5">
          {
            navItems.map((item) => {
              const current = isCurrentPath(pathname, item.href)
              return (
                <li>
                  <a
                    href={withBase(item.href)}
                    data-nav-href={item.href}
                    class:list={[
                      'transition-colors hover:text-accent dark:hover:text-accent-dark',
                      current
                        ? 'text-accent dark:text-accent-dark'
                        : 'text-muted dark:text-muted-dark',
                    ]}
                    aria-current={current ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              )
            })
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  const ACTIVE = ['text-accent', 'dark:text-accent-dark']
  const IDLE = ['text-muted', 'dark:text-muted-dark']

  const normalizePath = (pathname: string) => pathname.replace(/\/$/, '') || '/'

  const syncNav = () => {
    const current = normalizePath(window.location.pathname)
    const home = document.querySelector<HTMLAnchorElement>('[data-nav-home]')
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-href]')

    if (home) {
      const homeHref = normalizePath(home.pathname)
      const isHome = current === homeHref
      if (isHome) {
        home.setAttribute('aria-current', 'page')
      } else {
        home.removeAttribute('aria-current')
      }
    }

    for (const link of links) {
      const href = link.dataset.navHref ?? ''
      const target = normalizePath(link.pathname)
      // Blog stays current for posts under /blog/
      const isCurrent =
        href === '/blog'
          ? current === target || current.startsWith(`${target}/`)
          : current === target

      link.classList.remove(...ACTIVE, ...IDLE)
      link.classList.add(...(isCurrent ? ACTIVE : IDLE))

      if (isCurrent) {
        link.setAttribute('aria-current', 'page')
      } else {
        link.removeAttribute('aria-current')
      }
    }
  }

  syncNav()
  document.addEventListener('astro:page-load', syncNav)
</script>
