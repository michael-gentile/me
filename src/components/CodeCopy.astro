---
/**
 * Progressive enhancement for rehype-wrapped code blocks.
 * Language labels are SSR; Copy buttons stay hidden until this script runs.
 */
---

<script>
  const bindCodeCopy = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')

    for (const button of buttons) {
      if (button.dataset.bound === 'true') {
        continue
      }

      button.dataset.bound = 'true'
      button.hidden = false
      const idleLabel = 'Copy'

      button.addEventListener('click', async () => {
        const figure = button.closest('figure')
        const pre = figure?.querySelector('pre')
        const text = pre?.textContent ?? ''

        if (!text) {
          return
        }

        try {
          await navigator.clipboard.writeText(text)
          button.textContent = 'Copied'
          window.setTimeout(() => {
            button.textContent = idleLabel
          }, 1600)
        } catch {
          button.textContent = 'Copy failed'
          window.setTimeout(() => {
            button.textContent = idleLabel
          }, 1600)
        }
      })
    }
  }

  bindCodeCopy()
  document.addEventListener('astro:page-load', bindCodeCopy)
</script>
