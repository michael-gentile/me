---
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import { siteMeta } from '../config'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { absoluteUrl, personJsonLd, websiteJsonLd } from '../lib/site'

type Props = {
  title?: string
  description?: string
  ogType?: 'website' | 'article'
  publishedTime?: Date
  jsonLd?: Record<string, unknown>[]
  markdownHref?: string
  ogImage?: string
}

const {
  title,
  description = siteMeta.description,
  ogType = 'website',
  publishedTime,
  jsonLd = [],
  markdownHref,
  ogImage,
} = Astro.props

const pageTitle = title ? `${title} · ${siteMeta.name}` : siteMeta.name
const canonical = new URL(Astro.url.pathname, Astro.site)
const defaultOgImage = absoluteUrl('/og/default.png')
const shareImage = ogImage ?? defaultOgImage
const graph = {
  '@context': 'https://schema.org',
  '@graph': [personJsonLd(), websiteJsonLd(), ...jsonLd],
}
const llmsHref = absoluteUrl('/llms.txt')
const rssHref = absoluteUrl('/rss.xml')
const sitemapHref = absoluteUrl('/sitemap-index.xml')
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={siteMeta.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    <link rel="canonical" href={canonical.href} />
    <link rel="describedby" href={llmsHref} type="text/markdown" title="llms.txt" />
    <link rel="alternate" type="application/rss+xml" title={`${siteMeta.name} blog`} href={rssHref} />
    <link rel="sitemap" href={sitemapHref} />
    {
      markdownHref && (
        <link rel="alternate" type="text/markdown" title="Markdown" href={markdownHref} />
      )
    }
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-source-sans" preload={[{ style: 'normal', subset: 'latin' }]} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>
      // Re-run after ClientRouter swaps so <html> keeps the chosen theme.
      const applyTheme = () => {
        const storedTheme = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const theme = storedTheme ?? (prefersDark ? 'dark' : 'light')
        document.documentElement.classList.toggle('dark', theme === 'dark')
      }
      applyTheme()
      if (!window.__themeAfterSwapBound) {
        window.__themeAfterSwapBound = true
        document.addEventListener('astro:after-swap', applyTheme)
      }
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased dark:bg-paper-dark dark:text-ink-dark">
    <Header />
    <!-- Outside <main>: View Transitions transform main, which traps position:fixed. -->
    <slot name="chrome" />
    <main id="main" class="mx-auto max-w-4xl px-6 py-16" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
